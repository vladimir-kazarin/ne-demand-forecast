# ISO Express account (https://www.iso-ne.com/participate/support/web-services-data)
ISONE_USERNAME=
ISONE_PASSWORD=

# Storage root: a local path for development, s3://bucket/prefix in production
NE_DATA_ROOT=data

# MLflow tracking server; leave unset to use a local ./mlruns store
MLFLOW_TRACKING_URI=

# Alerts
SLACK_WEBHOOK_URL=
