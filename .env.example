# ISO Express account (https://www.iso-ne.com/participate/support/web-services-data)
ISONE_USERNAME=
ISONE_PASSWORD=

# Storage root: a local path for development, s3://bucket/prefix in production
NE_DATA_ROOT=data

# MLflow tracking server (DagsHub: Remote button -> Experiments); leave unset for a local store
MLFLOW_TRACKING_URI=
MLFLOW_TRACKING_USERNAME=
# DagsHub access token: https://dagshub.com/user/settings/tokens
MLFLOW_TRACKING_PASSWORD=

# Alerts
SLACK_WEBHOOK_URL=
